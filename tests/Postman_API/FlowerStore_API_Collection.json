                    "name": "1.1 [Hợp lệ] Đăng ký tài khoản Khách hàng mới thành công",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "const rand = Math.floor(Math.random() * 90000) + 10000;",
                                    "pm.variables.set('rand_user', 'khach_' + rand);",
                                    "pm.variables.set('rand_email', 'khach_' + rand + '@example.test');",
                                    "pm.variables.set('rand_phone', '098' + rand + '12');"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"HTTP 200, 201 hoặc 302: Đăng ký hợp lệ\", function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 302]);",
                                    "});",
                                    "pm.test(\"Thời gian phản hồi đăng ký < 5000ms\", function () {",
                                    "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                                    "});"
